# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요: cp .env.example .env
# (.env 는 .gitignore 에 포함되어 커밋되지 않습니다)
# Vite는 VITE_ 접두사가 붙은 변수만 브라우저 코드에 노출합니다.

# 백엔드 API 주소 — 셋 중 하나를 고르세요
#  ① 배포된 실서버 사용 (백엔드를 안 켜도 됨, 화면 담당 추천)
#     VITE_BACKEND_URL=https://program-in-pazama.onrender.com
#  ② 내 컴퓨터의 백엔드 사용 (백엔드 폴더의 실행하기.bat 도 켜야 함, 새 API 테스트할 때)
#     VITE_BACKEND_URL=http://localhost:8080
#  ③ 백엔드 없이 가짜 데이터 사용 → 맨 아래 VITE_USE_MOCK=true
VITE_BACKEND_URL=https://program-in-pazama.onrender.com

# Supabase 프로젝트 설정 (비워두면 로그인 기능만 비활성화됨)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true 로 바꾸면 백엔드 없이 src/mocks 의 가짜 데이터로 화면 개발 가능
VITE_USE_MOCK=false
